{
  "name": "one-man-jam-band-studio",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "find src -type f -name '*.js' -print0 | xargs -0 -n1 node --check",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run check && npm test && npm run test:browser",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  }
}
